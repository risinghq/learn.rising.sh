{
  "$schema": "./runner/worker/node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "overrides": [
    {
      "files": ["runner/worker/test/**"],
      "rules": {
        "eslint/no-await-in-loop": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      // Worker.postMessage takes no target origin: the rule is for window.postMessage.
      "files": ["site/player/pyodide-*.ts"],
      "rules": {
        "unicorn/require-post-message-target-origin": "off"
      }
    },
    {
      "files": ["tools/**", "tests/**"],
      "rules": {
        "eslint/no-await-in-loop": "off"
      }
    }
  ],
  "ignorePatterns": ["site/vendor/**", ".cache/**", "**/node_modules/**"]
}
